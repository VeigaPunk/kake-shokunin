+def gate_option_names(gate):
+    """Return the gate parser's long option names as (valued, flags).
+
+    The gate source is compiled and executed in a private namespace (no import,
+    no bytecode written) so the table always comes from the gate this run
+    executes, wherever the runner itself is placed.
+    """
+    namespace = {"__name__": "citing_set_gate", "__file__": str(gate)}
+    exec(compile(gate.read_bytes(), str(gate), "exec"), namespace)
+    valued, flags = [], []
+    for action in namespace["build_parser"]()._actions:
+        names = flags if action.nargs == 0 else valued
+        names.extend(option[2:] for option in action.option_strings if option.startswith("--"))
+    return tuple(valued), tuple(flags)
