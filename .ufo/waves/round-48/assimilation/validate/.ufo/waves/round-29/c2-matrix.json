{
 "schema": "kake-base-path-matrix-v1",
 "round": 29,
 "tool": "scripts/base_path_audit.py",
 "invocation": "python3 -B scripts/base_path_audit.py --manifest <dir>/manifest.json   (cases with argv run that argv instead)",
 "interface": [
  "stdout: one JSON object {verdict, pagesChecked, referencesChecked, findings:[{id, reason, page, element, attribute, value, resolved}]} for exits 0, 1 and 2; exit 64 needs no JSON",
  "exit 0 verdict clean; exit 1 verdict failed-policy (only outside_base_path findings); exit 2 verdict could-not-evaluate (reasons input_invalid or page_outside_base_path, all findings input-class); exit 64 usage",
  "manifest v1: {version:1, basePath:'/…/' starting and ending with '/', pages:[{file: relative path inside the manifest directory, url: absolute http(s) page URL whose path is under basePath}]} (non-empty pages)",
  "references: a/area/link[href], img/script/iframe/source/audio/video/track/embed[src], img/source[srcset] (each candidate URL), video[poster], form[action]; the first base element with href sets the document base (S024)",
  "ignored: values empty after stripping ASCII whitespace, non-http(s) schemes, other origins (scheme, host, port); same-origin references whose resolved path starts with basePath, or equals basePath without its final slash, are inside",
  "finding value: the raw attribute value after HTML entity decoding (for srcset, the candidate URL text)"
 ],
 "comparison": "per case: exit equal; for exit 0/1/2 the verdict equal and the sorted multiset of expected finding tuples equal to the observed tuples, where an expected finding's keys (reason, and element/attribute/value when given) select the observed keys compared",
 "cases": [
  {
   "id": "K1-relative-refs-clean",
   "kind": "control",
   "files": {
    "manifest.json": "{\"version\": 1, \"basePath\": \"/repo/\", \"pages\": [{\"file\": \"index.html\", \"url\": \"https://o.github.io/repo/\"}]}",
    "index.html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"style.css\"><title>t</title></head><body><a href=\"#top\">t</a><a href=\"?q=1\">q</a><a href=\"./x/\">x</a><img src=\"img/a.png\"></body></html>\n"
   },
   "expect": {
    "exit": 0,
    "verdict": "clean",
    "findings": []
   },
   "note": "relative references stay under the base"
  },
