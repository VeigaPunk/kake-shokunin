+def plant_dangling(root: str, rev: str, fleet_real: str, tmp: list[str]) -> tuple[str, int, dict[str, tuple[str, str, str]], tuple[int, ...] | None]:
+    """Commit one per-run random citation of an id the lane registry lacks into a copy of `root`@`rev`, then run the tool there."""
+    d = sandbox_clone(root, rev)
+    tmp.append(d)
+    kdir = os.path.join(d, "corpus/knowledge")
+    files = sorted(os.path.join(dp, f) for dp, _, fs in os.walk(kdir) for f in fs if f.endswith(".md"))
+    if not files:
+        raise RuntimeError("no knowledge file to plant into")
+    registry = git("-C", d, "show", f"{rev}:corpus/SOURCES.md").stdout
+    known = set(re.findall(r"^ {0,3}\| (S\d{3,}) \|", registry, re.MULTILINE))
+    rng = random.SystemRandom()
+    for digits in (4, 5):
+        for _ in range(50):
+            planted = "S" + "".join(rng.choice("0123456789") for _ in range(digits))
+            if planted not in known:
+                break
+        else:
+            continue
+        break
+    else:
+        raise RuntimeError("could not draw an unregistered id")
+    target = max(files, key=os.path.getsize)
+    with open(target, "a") as f:
+        f.write(f"\nPlanted dangling citation {planted}.\n")
+    ident = ["-c", "user.name=selftest", "-c", "user.email=selftest@local", "-c", "commit.gpgsign=false"]
+    for cmd in (["add", "-A"], ["commit", "-q", "-m", "gate planted dangling id"]):
+        p = git(*ident, "-C", d, *cmd)
+        if p.returncode != 0:
+            raise RuntimeError(f"git {' '.join(cmd)}: {p.stderr.strip()}")
+    nrev = git("-C", d, "rev-parse", "HEAD").stdout.strip()
+    rc, out = run_tool(d, "--root", d, "--revision", nrev, "--fleet", fleet_real)
+    dang, summ = parse(out)
+    return planted, rc, dang, summ
 
 
