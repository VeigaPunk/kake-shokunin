+def _fence_open(line):
+    """(char, length) when `line` opens a code fence, else None (CommonMark 4.5: 0-3 spaces, 3+ of ` or ~)."""
+    m = FENCE_RE.match(line)
+    if not m:
+        return None
+    marker = m.group(2)
+    if marker[0] == "`" and "`" in m.group(3):  # a backtick fence's info string may not contain a backtick
+        return None
+    return marker[0], len(marker)
+
+
+def _fence_closed(line, fence):
+    """True when `line` closes `fence`: same character, at least its length, only whitespace after (CommonMark 4.6)."""
+    char, length = fence
+    m = FENCE_RE.match(line)
+    if not m:
+        return False
+    marker = m.group(2)
+    return marker[0] == char and len(marker) >= length and not m.group(3).strip(" \t")
+
