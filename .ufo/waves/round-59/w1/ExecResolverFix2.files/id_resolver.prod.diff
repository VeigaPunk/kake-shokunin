+def _visible(path):
+    """A path with any byte that is not valid UTF-8 shown as a visible `\\xNN` escape."""
+    out = []
+    for ch in path:
+        code = ord(ch)
+        if 0xDC80 <= code <= 0xDCFF:  # a surrogateescape byte from os.fsdecode / os.listdir
+            out.append("\\x%02x" % (code - 0xDC00))
+        else:
+            out.append(ch)
+    return "".join(out)
